{
  "manifest_version": 1,
  "type": "device",
  "name": "ARSO Slovenia",
  "description": {
    "en": "Slovenian weather from ARSO: nearest station, regional forecast and official warnings.",
    "fr": "Météo slovène de l'ARSO : station la plus proche, prévisions régionales, avertissements officiels.",
    "de": "Wetter der slowenischen ARSO: nächste Station, regionale Vorhersage und amtliche Warnungen.",
    "es": "Tiempo de Eslovenia de ARSO: estación más cercana, previsión regional y alertas oficiales."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-arso:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-arso/main/cover.png",
  "categories": ["environment"],
  "countries": ["SI"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "ARSO",
        "fr": "ARSO",
        "de": "ARSO",
        "es": "ARSO"
      },
      "description": {
        "en": "Open data of ARSO (Agencija Republike Slovenije za okolje), the Slovenian Environment Agency: no account, no key. By default, the integration uses the position of your first Gladys house: the nearest automatic station, the forecast of its region and the warnings of its area. Not affiliated with ARSO.",
        "fr": "Données ouvertes de l'ARSO (Agencija Republike Slovenije za okolje), l'agence slovène de l'environnement : ni compte, ni clé. Par défaut, l'intégration prend la position de votre première maison Gladys : la station automatique la plus proche, les prévisions de sa région et les avertissements de sa zone. Sans lien avec l'ARSO.",
        "de": "Offene Daten der ARSO (Agencija Republike Slovenije za okolje), der slowenischen Umweltagentur: kein Konto, kein Schlüssel. Standardmäßig nutzt die Integration die Position deines ersten Gladys-Zuhauses: die nächste automatische Station, die Vorhersage ihrer Region und die Warnungen ihres Gebiets. Keine Verbindung zur ARSO.",
        "es": "Datos abiertos de ARSO (Agencija Republike Slovenije za okolje), la agencia eslovena de medio ambiente: sin cuenta ni clave. Por defecto, la integración usa la posición de su primera casa de Gladys: la estación automática más cercana, la previsión de su región y las alertas de su zona. Sin relación con ARSO."
      },
      "links": [
        {
          "url": "https://meteo.arso.gov.si/",
          "label": {
            "en": "ARSO weather (meteo.si)",
            "fr": "Météo de l'ARSO (meteo.si)",
            "de": "ARSO-Wetter (meteo.si)",
            "es": "Tiempo de ARSO (meteo.si)"
          }
        },
        {
          "url": "https://meteo.arso.gov.si/uploads/meteo/help/sl/copyright.html",
          "label": {
            "en": "Reuse terms of ARSO",
            "fr": "Conditions de réutilisation de l'ARSO",
            "de": "Nutzungsbedingungen der ARSO",
            "es": "Condiciones de reutilización de ARSO"
          }
        }
      ]
    },
    {
      "key": "house",
      "type": "select",
      "source": "houses",
      "label": {
        "en": "House",
        "fr": "Maison",
        "de": "Zuhause",
        "es": "Casa"
      },
      "description": {
        "en": "The house whose position is used. Empty: the first house with a position.",
        "fr": "La maison dont la position est utilisée. Vide : la première maison qui a une position.",
        "de": "Das Zuhause, dessen Position genutzt wird. Leer: das erste Zuhause mit Position.",
        "es": "La casa cuya posición se usa. Vacío: la primera casa con posición."
      },
      "required": false
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Latitude (optional)",
        "fr": "Latitude (facultatif)",
        "de": "Breitengrad (optional)",
        "es": "Latitud (opcional)"
      },
      "description": {
        "en": "To use another place than a house. Takes precedence over the house.",
        "fr": "Pour un autre lieu qu'une maison. Prioritaire sur la maison.",
        "de": "Für einen anderen Ort als ein Zuhause. Hat Vorrang vor dem Zuhause.",
        "es": "Para otro lugar que una casa. Tiene prioridad sobre la casa."
      },
      "placeholder": {
        "en": "e.g. 46.05",
        "fr": "ex. 46,05",
        "de": "z. B. 46,05",
        "es": "p. ej. 46,05"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "longitude",
      "type": "string",
      "label": {
        "en": "Longitude (optional)",
        "fr": "Longitude (facultatif)",
        "de": "Längengrad (optional)",
        "es": "Longitud (opcional)"
      },
      "placeholder": {
        "en": "e.g. 14.51",
        "fr": "ex. 14,51",
        "de": "z. B. 14,51",
        "es": "p. ej. 14,51"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "station_id",
      "type": "string",
      "label": {
        "en": "Weather station (optional)",
        "fr": "Station météo (facultatif)",
        "de": "Wetterstation (optional)",
        "es": "Estación meteorológica (opcional)"
      },
      "description": {
        "en": "Id of an ARSO automatic station. Empty: the nearest one. The action below lists them.",
        "fr": "Identifiant d'une station automatique de l'ARSO. Vide : la plus proche. L'action ci-dessous les liste.",
        "de": "ID einer automatischen ARSO-Station. Leer: die nächste. Die Aktion unten listet sie auf.",
        "es": "Identificador de una estación automática de ARSO. Vacío: la más cercana. La acción de abajo las lista."
      },
      "placeholder": {
        "en": "e.g. LJUBL-ANA_BEZIGRAD",
        "fr": "ex. LJUBL-ANA_BEZIGRAD",
        "de": "z. B. LJUBL-ANA_BEZIGRAD",
        "es": "p. ej. LJUBL-ANA_BEZIGRAD"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "Most stations report every 10 minutes, some every 30.",
        "fr": "La plupart des stations publient toutes les 10 minutes, certaines toutes les 30.",
        "de": "Die meisten Stationen melden alle 10 Minuten, manche alle 30.",
        "es": "La mayoría de las estaciones publican cada 10 minutos, algunas cada 30."
      },
      "required": false,
      "default": "10",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 minutes",
            "fr": "60 minutes",
            "de": "60 Minuten",
            "es": "60 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Used when the devices are created, and for the scene event texts.",
        "fr": "Utilisée à la création des appareils, et pour les textes des événements de scène.",
        "de": "Wird beim Anlegen der Geräte und für die Texte der Szenen-Ereignisse genutzt.",
        "es": "Se usa al crear los dispositivos y para los textos de los eventos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
