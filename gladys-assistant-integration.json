        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_stations",
      "label": {
        "en": "List the nearest stations",
        "fr": "Lister les stations proches",
        "de": "Nächste Stationen anzeigen",
        "es": "Listar las estaciones cercanas"
      },
      "timeout_seconds": 30
    },
    {
      "key": "check_connection",
      "label": {
        "en": "Check the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "warning_issued",
      "label": {
        "en": "New ARSO warning",
        "fr": "Nouvel avertissement de l'ARSO",
        "de": "Neue ARSO-Warnung",
        "es": "Nueva alerta de ARSO"
      },
      "description": {
        "en": "ARSO issued a weather warning (yellow, orange or red) for the area of the place, or raised its level. Fires as soon as it is announced, often a day or more before it starts.",
        "fr": "L'ARSO a émis un avertissement météo (jaune, orange ou rouge) pour la zone du lieu, ou en a relevé le niveau. Se déclenche dès l'annonce, souvent un jour ou plus avant le début.",
        "de": "Die ARSO hat für das Gebiet des Orts eine Wetterwarnung (gelb, orange oder rot) ausgegeben oder ihre Stufe erhöht. Löst bei der Ankündigung aus, oft einen Tag oder mehr vor Beginn.",
        "es": "ARSO ha emitido una alerta meteorológica (amarilla, naranja o roja) para la zona del lugar, o ha subido su nivel. Se activa en cuanto se anuncia, a menudo un día o más antes del inicio."
      },
